  dialogLength: 14
  dialog:
  - B
  - "\u545C\u545C\u545C\u2026\u2026"
  - A
  - "\u81E3\u62DC\u89C1\u5C0F\u59D0\uFF0C\u8BF7\u5C0F\u59D0\u8282\u54C0\uFF0C\u6211\u76F8\u4FE1\u5C06\u519B\u662F\u4E0D\u4F1A\u505A\u51FA\u8FD9\u79CD\u4E8B\u60C5\u7684\uFF01\u5C06\u519B\u4E3A\u8FD9\u4E2A\u56FD\u5BB6\u4ED8\u51FA\u4E86\u8FD9\u4E48\u591A\uFF0C\u800C\u5982\u4ECA\u56FD\u738B\u5374\u4E0B\u4EE4\u56DB\u5904\u6293\u6355\u548C\u5C06\u519B\u6709\u5173\u4E4B\u4EBA\uFF0C\u5C0F\u59D0\u597D\u4E0D\u5BB9\u6613\u9003\u51FA\u7687\u57CE\uFF0C\u8D76\u5FEB\u8FDC\u79BB\u8FD9\u4E2A\u56FD\u5BB6\u5427\u2026\u2026"
  - B
  - "\u4F60\u2026\u4F60\u4E5F\u8D76\u5FEB\u548C\u6211\u4E00\u8D77\u79BB\u5F00\u5427\u2026\u2026\u4F60\u662F\u6211\u552F\u4E00\u53EF\u4EE5\u4FE1\u4EFB\u548C\u4EB2\u8FD1\u7684\u4EBA\u4E86\uFF08\u62BD\u6CE3\uFF09"
  - A
  - "\u4E0D\u884C\uFF0C\u6211\u8FD8\u4E0D\u80FD\u8D70\uFF0C\u6211\u4E00\u5B9A\u8981\u53BB\u8C03\u67E5\u51FA\u5C06\u519B\u7A76\u7ADF\u662F\u4E3A\u4F55\u88AB\u5BB3\u7684\uFF01"
  - B
  - "\u6211\u4EEC\u81EA\u5E7C\u751F\u6D3B\u5728\u4E00\u8D77\uFF0C\u6211\u77E5\u9053\u4F60\u7684\u51B3\u5B9A\u662F\u65E0\u6CD5\u6539\u53D8\u7684\uFF0C\u4F46\u662F\u4F60\u7B54\u5E94\u6211\uFF0C\u8FD9\u6B21\u4F60\u53BB\u7687\u57CE\u540E\uFF0C\u4E00\u5B9A\u8981\u6D3B\u7740\u56DE\u6765\u554A\uFF01\u6211\u4F1A\u5728\u8FD9\u91CC\u7B49\u7740\u4F60\u2026\u2026"
  - A
  - "\u2026\u2026"
  - B
  - "\u8FD9\u662F\u6211\u4ECE\u7236\u4EB2\u623F\u95F4\u627E\u5230\u7684\u534A\u672C\u65E5\u8BB0\u548C\u4EC5\u5269\u76841000\u91D1\u5E01\u4E86\uFF0C\u5E0C\u671B\u5B83\u80FD\u5BF9\u4F60\u6709\u4E9B\u5E2E\u52A9\u2026\u2026"
  choiceLength: 0
  choice: []
